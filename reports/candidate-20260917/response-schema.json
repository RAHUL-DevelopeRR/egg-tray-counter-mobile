{
  "$defs": {
    "Geometry": {
      "additionalProperties": false,
      "properties": {
        "x_columns": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X Columns"
        },
        "y_rows": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y Rows"
        },
        "status": {
          "const": "unresolved",
          "default": "unresolved",
          "title": "Status",
          "type": "string"
        }
      },
      "title": "Geometry",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "BOTTOM_DARK",
            "REGION_DARK",
            "TOP_CROPPED",
            "BASE_CROPPED",
            "MOTION_BLUR",
            "STACK_OCCLUDED",
            "SHARED_CORNER_MISSING",
            "REAR_ROW_NOT_VISIBLE",
            "OCCUPANCY_UNCLEAR",
            "RIM_CONTRAST_LOW",
            "STACK_LOCALIZATION_INCOMPLETE",
            "SOP_VIOLATION",
            "IMAGE_QUALITY"
          ],
          "title": "Code",
          "type": "string"
        },
        "view": {
          "enum": [
            "left",
            "straight",
            "right"
          ],
          "title": "View",
          "type": "string"
        },
        "stack": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stack"
        },
        "region": {
          "title": "Region",
          "type": "string"
        },
        "cause": {
          "title": "Cause",
          "type": "string"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "evidence_source": {
          "enum": [
            "measured_image",
            "operator_declared",
            "unresolved_evidence"
          ],
          "title": "Evidence Source",
          "type": "string"
        }
      },
      "required": [
        "code",
        "view",
        "stack",
        "region",
        "cause",
        "action",
        "evidence_source"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "Rescan": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "recommendations": {
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "required": [
        "reason",
        "recommendations"
      ],
      "title": "Rescan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scan_contract": {
      "const": "spatial_3d_beam_v1",

<?xml version="1.0" encoding="utf-8"?>
<!-- The device key lives in Android secure storage, bound to this phone's Keystore. A restored or
     transferred copy could not be decrypted, so the app data is excluded from cloud backup and
     device transfer; a new phone registers itself and is approved again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
